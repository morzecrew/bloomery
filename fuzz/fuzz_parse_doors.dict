# libFuzzer dictionary for `fuzz_parse_doors` (S-0008).
#
# The project's own vocabulary, so a mutation lands on a word that reaches code
# rather than on a random identifier that dies at the first lookup. Three
# groups: SQL the parse doors read, the spec keys the splice sits inside, and
# the names bloomery itself resolves — a transform name from this list reaches
# a chain the compiler walks; `xqz` never does.


sql_0="SELECT"
sql_1="FROM"
sql_2="WHERE"
sql_3="CASE"
sql_4="WHEN"
sql_5="THEN"
sql_6="ELSE"
sql_7="END"
