# libFuzzer dictionary for fuzz_load_project.py.
#
# The spec language, not SQL's: a token that is a real document key, a real
# kind or a real name reaches the model layer and the cross-document
# resolution behind it, and a random identifier reaches the YAML parser and
# stops. Kept to what the fixture set and the spec models actually spell, so it
# stays checkable against the tree.

# ....................... #
# YAML's own metacharacters — what decides whether a document parses at all

":"
": "
"- "
"---"
"..."
"&a"
"*a"
"<<"
"!!"
"!!python/object/apply:"
"? "
"|"
">"
"{"
"}"
"["
"]"
"\""
"'"
"#"
"\x09"
"\x0a"
"\x0a  "
"\x0a    "
"\x0a      "
"\x00"

# ....................... #
# The version keys — what decides a document's kind

"catalog_version: 1"
"spec_version: 1"
"mapping_version: 1"
"metrics_version: 1"
"marts_version: 1"
"steps_version: 1"
"exposures_version: 1"
"imports_version: 1"
"exports_version: 1"

