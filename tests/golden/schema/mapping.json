          "default": null
        },
        "rule": {
          "const": "coercible",
          "title": "Rule",
          "type": "string"
        }
      },
      "required": [
        "on_fail",
        "rule"
      ],
      "title": "CoercibleRule",
      "type": "object"
    },
    "InEnumRule": {
      "additionalProperties": false,
      "description": "``{rule: in_enum}`` \u2014 the value survived its ``enum_map`` chain\nunmapped. Parameterless by construction: the admissible set *is* the\nchain's mapping, and restating it here would let the two drift.",
      "properties": {
        "on_fail": {
          "enum": [
            "flag",
            "quarantine",
            "fail",
            "repair"
          ],
          "title": "On Fail",
          "type": "string"
