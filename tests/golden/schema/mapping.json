                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "on_fail",
        "rule",
        "values"
      ],
      "title": "InSetRule",
      "type": "object"
    },
    "KeyField": {
      "additionalProperties": false,
      "description": "Key-column lowering: a JSONPath-lite source path plus transform chain.",
      "properties": {
