      ],
      "title": "InEnumRule",
      "type": "object"
    },
    "InSetRule": {
      "additionalProperties": false,
      "description": "``{rule: in_set, values: [...]}`` \u2014 membership in a literal set\ndeclared inline; at least one value (an empty set fails every row).",
      "properties": {
