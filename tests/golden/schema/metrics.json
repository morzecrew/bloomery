{
  "$defs": {
    "CumulativeSpec": {
      "additionalProperties": false,
      "description": "A metric's accumulation over time (RFC 0002 D10, lowered by RFC 0034\nD5): exactly one of a trailing ``window`` or a ``grain_to_date``.\n\n``{window: \"7 days\"}`` is a trailing seven-day total; ``{grain_to_date:\nmonth}`` is month-to-date. The metric keeps its own measure and its own\n``additivity`` \u2014 that describes the measure, while this describes how the\nmeasure accumulates (D6).\n\n``period_agg`` decides what a request coarser than the accumulation gets;\nsee :data:`PeriodAggregationName` for why it defaults to ``last``.",
      "properties": {
        "grain_to_date": {
          "anyOf": [
            {
              "enum": [
                "day",
                "week",
                "month",
                "quarter",
                "year"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grain To Date"
        },
        "period_agg": {
          "default": "last",
          "enum": [
            "first",
            "last",
            "average"
          ],
          "title": "Period Agg",
          "type": "string"
        },
        "window": {
          "anyOf": [
            {
              "pattern": "^[1-9][0-9]* (?:day|week|month|quarter|year)s?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window"
        }
      },
      "title": "CumulativeSpec",
      "type": "object"
    },
    "DerivedSpec": {
      "additionalProperties": false,
      "description": "A metric computed by an expression over other metrics (RFC 0034 D1).\n\n``inputs`` is a mapping keyed by alias rather than a list: the alias is\nthe input's identity because ``expr`` references it, and a mapping makes a\nduplicate alias unrepresentable instead of something to validate. That the\nexpression references only declared aliases is a guardrail \u2014 it needs the\nparsed expression, which lives a layer up.",
      "properties": {
        "expr": {
          "title": "Expr",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/MetricInputSpec"
          },
          "minProperties": 1,
          "title": "Inputs",
          "type": "object"
        }
      },
      "required": [
        "expr",
        "inputs"
      ],
      "title": "DerivedSpec",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "description": "One authored metric: a template instantiation or an inline definition.\n\nShape-only at parse (RFC 0002 D4): whether ``template`` exists, leaves are\nreachable, or the additivity policy is complete is checked downstream\n(resolution RFC 0005; guardrails RFC 0006).",
      "properties": {
        "additivity": {
          "anyOf": [
            {
              "enum": [
                "additive",
                "semi_additive",
                "non_additive"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Additivity"
        },
        "agg": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agg"
        },
        "cumulative": {
          "anyOf": [
            {
              "$ref": "#/$defs/CumulativeSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "derived": {
          "anyOf": [
            {
              "$ref": "#/$defs/DerivedSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "expr": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expr"
        },
        "filter": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MetricFilter"
          },
          "title": "Filter",
          "type": "array"
        },
        "grain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grain"
        },
        "ratio": {
          "anyOf": [
            {
              "$ref": "#/$defs/RatioSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "requires": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Requires",
          "type": "array"
        },
        "requires_metrics": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Requires Metrics",
          "type": "array"
        },
        "semi_additive": {
          "anyOf": [
            {
              "$ref": "#/$defs/SemiAdditivePolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Template"
        }
      },
      "title": "Metric",
      "type": "object"
    },
    "MetricFilter": {
      "additionalProperties": false,
      "description": "One row-level restriction on a metric (RFC 0034 D8).\n\n``dimension`` names a column flattened on the mart carrying the metric;\nthat it is flattened, and that ``values`` fit its declared type, is a\nguardrail (D9) \u2014 this layer checks only what is decidable from the\ndocument: the operator/arity coherence, and that the name is a bare\nidentifier. The second is not cosmetic \u2014 see\n:data:`~bloomery.spec.common.DimensionName`, which the reference is typed\nwith: this is the one place a member name reaches a template unquoted.",
      "properties": {
        "dimension": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Dimension",
          "type": "string"
        },
        "op": {
          "enum": [
            "eq",
            "ne",
            "in",
            "not_in",
            "gt",
            "gte",
            "lt",
            "lte",
            "is_null"
          ],
          "title": "Op",
          "type": "string"
        },
        "values": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "format": "date",
                "type": "string"
              },
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "dimension",
        "op"
      ],
      "title": "MetricFilter",
      "type": "object"
    },
    "MetricInputSpec": {
      "additionalProperties": false,
      "description": "One input of a derived metric \u2014 the metric read, and optionally the\noffset it is read at. Its *alias* is the key it sits under in\n:attr:`DerivedSpec.inputs`, because the alias is what the expression\nreferences (RFC 0034 D1).",
      "properties": {
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "offset": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetricOffset"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "metric"
      ],
      "title": "MetricInputSpec",
      "type": "object"
    },
    "MetricOffset": {
      "additionalProperties": false,
      "description": "How far back a derived metric's input reads (RFC 0034 D2): exactly one\nof a fixed ``window`` or the start of the containing period.\n\n``{window: \"1 year\"}`` against a monthly grouping is the same month one\nyear earlier; ``{to_grain: month}`` against a daily grouping is the first\nday of each row's own month.",
      "properties": {
        "to_grain": {
          "anyOf": [
            {
              "enum": [
                "day",
                "week",
                "month",
                "quarter",
                "year"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Grain"
        },
        "window": {
          "anyOf": [
            {
              "pattern": "^[1-9][0-9]* (?:day|week|month|quarter|year)s?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window"
        }
      },
      "title": "MetricOffset",
      "type": "object"
    },
    "RatioSpec": {
      "additionalProperties": false,
      "description": "Additive decomposition of a non-additive metric (RFC 0002 D9, RFC 0011 D5).",
      "properties": {
        "denominator": {
          "title": "Denominator",
          "type": "string"
        },
        "numerator": {
          "title": "Numerator",
          "type": "string"
        }
      },
      "required": [
        "denominator",
        "numerator"
      ],
      "title": "RatioSpec",
      "type": "object"
    },
    "SemiAdditivePolicy": {
      "additionalProperties": false,
      "description": "Typed semi-additive policy (RFC 0002 \u00a75.5): the dimension the metric is\nnot additive over, and the rule applied along it.",
      "properties": {
        "over": {
          "title": "Over",
          "type": "string"
        },
        "rule": {
          "enum": [
            "last",
            "first",
            "avg",
            "min",
            "max"
          ],
          "title": "Rule",
          "type": "string"
        }
      },
      "required": [
        "over",
        "rule"
      ],
      "title": "SemiAdditivePolicy",
      "type": "object"
    }
  },
  "$id": "https://morzecrew.github.io/bloomery/schemas/v1/metrics.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The per-project metric document (``metrics_version``), at most one per\nproject (RFC 0002 \u00a75.5).",
  "properties": {
    "metrics": {
      "additionalProperties": {
        "$ref": "#/$defs/Metric"
      },
      "title": "Metrics",
      "type": "object"
    },
    "metrics_version": {
      "const": 1,
      "title": "Metrics Version",
      "type": "integer"
    }
  },
  "required": [
    "metrics",
    "metrics_version"
  ],
  "title": "MetricSet",
  "type": "object"
}
