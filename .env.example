# The live Databricks lane (S-0016) and nothing else. Nothing reads a `.env`
# file — the lane reads the environment — so export them yourself:
#
#     cp .env.example .env && $EDITOR .env
#     set -a && . ./.env && set +a
#     uv run pytest tests/engines/test_databricks_live.py
#
# Absent, the lane skips with a stated reason and the default tiers never ask
# for a credential. `.env` is gitignored; this file holds no value worth having.
#
# A personal access token, not a service principal (S-0016/D-5): no
# machine-to-machine OAuth flow is documented as working on Databricks Free
# Edition. Free Edition is enough for this lane (S-0016/D-6) — serverless only,
# one 2X-Small warehouse, fair-use quotas, no SLA.
#
# The catalog and schema are the lane's own (S-0016/D-10). It creates and drops
# relations there under a per-run prefix, so point it at a schema nothing else
# writes to.

DATABRICKS_HOST=https://dbc-00000000-0000.cloud.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=bloomery_conformance
