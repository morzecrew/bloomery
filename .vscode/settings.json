{
    "files.associations": {
        "*.env*": "env",
        ".coveragerc": "ini",
        "uv.lock": "toml",
    },
    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.ruff_cache": true,
        "**/.import_linter_cache": true,
        "**/.mypy_cache": true,
        "**/.coverage": true,
        "**/.cache": true,
        "dist/": true,
        "**/.venv/": true,
        ".agent": true,
        // ".claude": true,
        ".benchmarks": true,
        ".markdownlint.yaml": true,
        "CLAUDE.md": true,
        "CODE_OF_CONDUCT.md": true,
        "CODEOWNERS": true,
        "LICENSE": true,
        "uv.lock": true,
        "skills-lock.json": true,
        "SECURITY.md": true,
        "coverage.json": true,
        ".pre-commit-config.yaml": true,
        "**/.hypothesis": true,
    },
    // Analysis config (typeCheckingMode, extraPaths, ignore, severity
    // overrides) lives in pyrightconfig.json at the repo root — the language
    // server ignores the editor-side equivalents whenever that file exists,
    // and one source keeps the editor and `uv tool run pyright` in agreement.
    // Only settings pyrightconfig.json cannot express belong here.
    "cursorpyright.analysis.diagnosticMode": "workspace",
    "python.analysis.diagnosticMode": "workspace",
    "cursorpyright.analysis.inlayHints.functionReturnTypes": true,
    "cursorpyright.analysis.inlayHints.variableTypes": true,
    "ty.diagnosticMode": "workspace",
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
    },
    "[json]": {
        "editor.tabSize": 2,
    },
    "[jsonc]": {
        "editor.tabSize": 2,
    },
    "[toml]": {
        "editor.tabSize": 4,
    },
    "[yaml]": {
        "editor.tabSize": 2,
    },
    "[github-actions-workflow]": {
        "editor.tabSize": 2,
    },
    "[markdown]": {
        "editor.tabSize": 4,
    },
    "remote.autoForwardPortsFallback": 0,
}
