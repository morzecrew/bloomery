{
  "typeCheckingMode": "strict",
  "pythonVersion": "3.12",
  "extraPaths": [
    "src"
  ],
  "include": [
    "src",
    "examples"
  ],
  "exclude": [
    "**/__pycache__",
    "**/.venv",
    "tests"
  ],
  "ignore": [
    "tests/**"
  ],
  "venvPath": ".",
  "venv": ".venv",
  "reportMissingTypeStubs": "none"
}
